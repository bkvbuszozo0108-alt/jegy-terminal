{
  "manifest_version": 2,
  "name": "Jegyterminál híd",
  "version": "1.0",
  "description": "A Zebra szkenner kódját adja át a web-appnak.",
  "browser_specific_settings": { "gecko": { "id": "jt@jegyterminal" } },
  "permissions": ["nativeMessaging", "geckoViewAddons"],
  "content_scripts": [ { "matches": ["<all_urls>"], "js": ["content.js"], "run_at": "document_end" } ]
}
