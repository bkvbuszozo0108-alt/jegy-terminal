<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:gravity="center_horizontal"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="6dp">
    <ImageView android:id="@+id/icon" android:layout_width="52dp" android:layout_height="52dp"/>
    <TextView android:id="@+id/label" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="11sp" android:gravity="center" android:maxLines="2" android:ellipsize="end" android:paddingTop="4dp"/>
</LinearLayout>
