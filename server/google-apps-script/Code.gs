/*  Jegyterminál – webes szerver Google Táblázatban (Apps Script)
    Telepítés: lásd README.md ebben a mappában. A KULCS csak a központi oldalhoz kell (a terminálok kulcs nélkül küldenek).  */
var KULCS = 'VALTOZTASD-MEG';          // ← saját kulcs (betűk/számok)
var SHEET = 'Beolvasasok';
var COLS = ['id','ts','device','inspector','place','code','name','type','day','ok','kind','verdict','why','fine','let','txn','test','mode'];
var M3 = ['Újpest-központ','Újpest-városkapu','Gyöngyösi utca','Forgách utca','Göncz Árpád városközpont','Dózsa György út','Lehel tér','Nyugati pályaudvar','Arany János utca','Deák Ferenc tér','Ferenciek tere','Kálvin tér','Corvin-negyed','Semmelweis Klinikák','Nagyvárad tér','Népliget','Ecseri út','Pöttyös utca','Határ út','Kőbánya-Kispest'];
var GDEF = {title:'BKK Jegyellenőrzés',mode:'jegy',fine:8000,dateCheck:true,graceH:6,dateRequire:false,night:'auto',nightFrom:'20:00',nightTo:'06:00',dim:0,welcome:'A jegy érvényes. Belépés engedélyezve.',hwScan:false,lock:true};

/* ---- központi beállítások (Beallitasok lap: kulcs | érték) és terminálok (Terminalok lap) ---- */
function gsheet_(){ var ss=SpreadsheetApp.getActiveSpreadsheet(); var sh=ss.getSheetByName('Beallitasok'); if(!sh){ sh=ss.insertSheet('Beallitasok'); sh.appendRow(['Beállítás','Érték']); sh.getRange('B:B').setNumberFormat('@'); Object.keys(GDEF).forEach(function(k){ sh.appendRow([k,GDEF[k]]); }); sh.setFrozenRows(1); } return sh; }
var CHUNK=40000;
function getGlobal_(){ var sh=gsheet_(), n=sh.getLastRow(), g={}, parts={}; Object.keys(GDEF).forEach(function(k){ g[k]=GDEF[k]; });
  if(n>=2){ var v=sh.getRange(2,1,n-1,2).getValues(); v.forEach(function(r){ if(r[0]==='') return; var k=String(r[0]), val=r[1]; if(val instanceof Date) val=Utilities.formatDate(val,Session.getScriptTimeZone(),'HH:mm'); var m=/^(.+)__(\d+)$/.exec(k); if(m){ parts[m[1]]=parts[m[1]]||{}; parts[m[1]][+m[2]]=String(val); } else g[k]=val; }); }
  Object.keys(parts).forEach(function(k){ var ps=parts[k], out=String(g[k]||''); Object.keys(ps).map(Number).sort(function(a,b){return a-b;}).forEach(function(i){ out+=ps[i]; }); g[k]=out; });
  return g; }
function setGlobal_(obj){ var sh=gsheet_(), n=sh.getLastRow(), rows=n>=2?sh.getRange(2,1,n-1,2).getValues():[], idx={}; rows.forEach(function(r,i){ idx[String(r[0])]=i+2; });
  function put(k,v){ if(idx[k]){ var c=sh.getRange(idx[k],2); c.setNumberFormat('@'); c.setValue(v); } else { sh.appendRow([k,v]); idx[k]=sh.getLastRow(); sh.getRange(idx[k],2).setNumberFormat('@'); } }
  Object.keys(obj).forEach(function(k){ var v=obj[k]; if(v!==null&&typeof v==='object') v=JSON.stringify(v); v=(v===undefined||v===null)?'':String(v);
    for(var i=2;i<40;i++){ if(idx[k+'__'+i]) put(k+'__'+i,''); else break; }
    if(v.length<=CHUNK) put(k,v); else { put(k,v.slice(0,CHUNK)); var j=2; for(var pos=CHUNK;pos<v.length;pos+=CHUNK,j++) put(k+'__'+j,v.slice(pos,pos+CHUNK)); } }); }
/* ---- feliratok és színek (Szovegek / Szinek lap): Kulcs | Leírás | Alapérték | Saját érték ---- */
function msheet_(name){ var ss=SpreadsheetApp.openById(SHEET_ID); var sh=ss.getSheetByName(name); if(!sh){ sh=ss.insertSheet(name); sh.appendRow(['Kulcs','Leírás','Alapérték','Saját érték']); sh.setFrozenRows(1); sh.getRange('D:D').setNumberFormat('@'); } return sh; }
function metaRows_(name){ var sh=msheet_(name), n=sh.getLastRow(); if(n<2) return []; return sh.getRange(2,1,n-1,4).getValues().map(function(r,i){ return {k:String(r[0]),label:String(r[1]),def:String(r[2]),val:String(r[3]),_row:i+2}; }).filter(function(r){return r.k!=='';}); }
function metaMerge_(name,list){ var sh=msheet_(name), have={}; metaRows_(name).forEach(function(r){ have[r.k]=1; }); var add=[]; (list||[]).forEach(function(t){ if(!have[t[0]]) add.push([t[0],t[1],t[2],'']); }); if(add.length) sh.getRange(sh.getLastRow()+1,1,add.length,4).setValues(add); }
function metaVals_(name){ var o={}; metaRows_(name).forEach(function(r){ if(r.val!=='') o[r.k]=r.val; }); return o; }
function metaSet_(name,obj){ var sh=msheet_(name), rows=metaRows_(name); rows.forEach(function(r){ var v=obj.hasOwnProperty(r.k)?String(obj[r.k]||''):''; if(v!==r.val) sh.getRange(r._row,4).setValue(v); }); }
function colorSets_(){ var all=metaVals_('Szinek'), c={}, n={}; Object.keys(all).forEach(function(k){ if(k.indexOf('n-')===0) n[k]=all[k]; else c[k]=all[k]; }); return {colors:c,ncolors:n}; }
function tsheet_(){ var ss=SpreadsheetApp.getActiveSpreadsheet(); var sh=ss.getSheetByName('Terminalok'); if(!sh){ sh=ss.insertSheet('Terminalok'); sh.appendRow(['Terminál','Jegyellenőr azonosító','Állomás','Létrehozva','Utoljára']); sh.setFrozenRows(1); } return sh; }
function devices_(){ var sh=tsheet_(), n=sh.getLastRow(), out={}; if(n>=2){ sh.getRange(2,1,n-1,5).getValues().forEach(function(r,i){ if(r[0]!=='') out[r[0]]={inspector:String(r[1]),place:String(r[2]),created:r[3]instanceof Date?r[3].toISOString():String(r[3]),seen:r[4]instanceof Date?r[4].toISOString():String(r[4]),_row:i+2}; }); } return out; }
function deviceCfg_(dev){ var sh=tsheet_(), all=devices_(), d=all[dev]; if(!d){ var seq=Object.keys(all).length+1; var ins='BKK-'+('0000'+seq).slice(-4); sh.appendRow([dev,ins,M3[0],new Date(),new Date()]); return {inspector:ins,place:M3[0]}; } sh.getRange(d._row,5).setValue(new Date()); return d; }
function configFor_(dev){ var g=getGlobal_(), d=deviceCfg_(dev); var out={}; Object.keys(g).forEach(function(k){ out[k]=g[k]; }); out.sub=d.place; out.id=d.inspector; out.lock=g.lock!==false&&g.lock!=='false'; out.device=dev; ['dateCheck','dateRequire','hwScan'].forEach(function(k){ if(typeof out[k]==='string') out[k]=(out[k]==='true'); });
  out.tx=metaVals_('Szovegek'); var cs=colorSets_(); out.colors=cs.colors; out.ncolors=cs.ncolors; return out; }

function sheet_(){ var ss=SpreadsheetApp.getActiveSpreadsheet(); var sh=ss.getSheetByName(SHEET); if(!sh){ sh=ss.insertSheet(SHEET); sh.appendRow(['Azonosító','Idő','Terminál','Ellenőr','Helyszín','Kód','Név','Típus','Jegy dátuma','Érvényes','Fajta','Eredmény','Indok','Pótdíj','Kézi beengedés','Tranzakció','Teszt','Mód']); sh.setFrozenRows(1); } return sh; }
function out_(o){ return ContentService.createTextOutput(JSON.stringify(o)).setMimeType(ContentService.MimeType.JSON); }
function key_(e,body){ var k=(e.parameter&&e.parameter.key)||(body&&body.key)||''; return k===KULCS; }
function rows_(){ var sh=sheet_(); var n=sh.getLastRow(); if(n<2) return []; var v=sh.getRange(2,1,n-1,COLS.length).getValues(); var out=[]; for(var i=0;i<v.length;i++){ var r={}; for(var c=0;c<COLS.length;c++) r[COLS[c]]=v[i][c]; r._row=i+2; if(r.ts instanceof Date) r.ts=r.ts.toISOString(); out.push(r); } return out; }
function fmtHu_(iso){ var d=new Date(iso); if(isNaN(d)) return String(iso||''); return Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy.MM.dd. HH:mm'); }
function dayOf_(iso){ var d=new Date(iso); if(isNaN(d)) return ''; return Utilities.formatDate(d,Session.getScriptTimeZone(),'yyyy-MM-dd'); }

function doPost(e){
  var body; try{ body=JSON.parse(e.postData.contents); }catch(x){ return out_({error:'rossz JSON'}); }
  /* terminál-beküldés kulcs nélkül megy; a beállítások módosításához kell a kulcs */
  if(body.op==='meta'){ var lk=LockService.getScriptLock(); lk.waitLock(20000); try{ metaMerge_('Szovegek',body.tx); metaMerge_('Szinek',body.colors); } finally{ lk.releaseLock(); } return out_({ok:true}); }
  if(body.op==='setconfig'){ if(!key_(e,body)) return out_({error:'hibás kulcs'}); if(body.global){ var gg=body.global; if(gg.tx!==undefined){ metaSet_('Szovegek',gg.tx||{}); delete gg.tx; } if(gg.colors!==undefined||gg.ncolors!==undefined){ var cc={}; Object.keys(gg.colors||{}).forEach(function(k){cc[k]=gg.colors[k];}); Object.keys(gg.ncolors||{}).forEach(function(k){cc[k]=gg.ncolors[k];}); metaSet_('Szinek',cc); delete gg.colors; delete gg.ncolors; } setGlobal_(gg); } if(typeof body.lock==='boolean') setGlobal_({lock:body.lock}); if(body.devices){ var sh=tsheet_(), all=devices_(); Object.keys(body.devices).forEach(function(k){ var d=all[k]; if(!d) return; var u=body.devices[k]; if(u.inspector) sh.getRange(d._row,2).setValue(u.inspector); if(u.place&&M3.indexOf(u.place)>=0) sh.getRange(d._row,3).setValue(u.place); }); } if(body.remove){ var all2=devices_(); if(all2[body.remove]) tsheet_().deleteRow(all2[body.remove]._row); } return out_({ok:true}); }
  var evs=body.events||body; if(!Array.isArray(evs)) evs=[evs];
  var lock=LockService.getScriptLock(); lock.waitLock(20000);
  try{
    var sh=sheet_(), all=rows_(), byId={}; all.forEach(function(r){ byId[r.id]=r; });
    var n=0;
    evs.forEach(function(ev){ if(!ev||!ev.id) return;
      if(ev.update){ var r=byId[ev.id]; if(!r) return; if(ev.fine) sh.getRange(r._row,COLS.indexOf('fine')+1).setValue(true); if(ev.let) sh.getRange(r._row,COLS.indexOf('let')+1).setValue(true); n++; return; }
      if(byId[ev.id]) return;
      var row=COLS.map(function(c){ var v=ev[c]; if(c==='ts') return v?new Date(v):new Date(); if(v===true) return true; if(v===false||v==null) return v===false?false:''; return v; });
      sh.appendRow(row); byId[ev.id]={id:ev.id}; n++; });
    return out_({ok:true,n:n});
  } finally { lock.releaseLock(); }
}

function doGet(e){
  var p=e.parameter||{}; var a=p.a||'';
  if(!a) return HtmlService.createHtmlOutput(DASH_()).setTitle('Jegyterminál – központ').setXFrameOptionsMode(HtmlService.XFrameOptionsMode.ALLOWALL);
  return out_(handle_(a,p));
}
/* a vezérlőpult (google.script.run) és a terminál (GET) is ezt hívja */
function api(a,p){ return handle_(a,p||{}); }
function handle_(a,p){
  if(a==='info') return {title:SpreadsheetApp.getActiveSpreadsheet().getName(),needKey:true};
  if(a==='config'){ var dev=String(p.device||''); if(!dev) return {error:'device?'}; var lock=LockService.getScriptLock(); lock.waitLock(10000); try{ return configFor_(dev); } finally{ lock.releaseLock(); } }
  if((p.key||'')!==KULCS&&a!=='used') return {error:'hibás kulcs'};
  if(a==='adminconfig'){ var g2=getGlobal_(); g2.tx=metaVals_('Szovegek'); var cs2=colorSets_(); g2.colors=cs2.colors; g2.ncolors=cs2.ncolors; return {global:g2,lock:g2.lock!==false&&g2.lock!=='false',devices:devices_(),M3:M3,meta:{tx:metaRows_('Szovegek').map(function(r){return [r.k,r.label,r.def];}),colors:metaRows_('Szinek').map(function(r){return [r.k,r.label,r.def];})}}; }
  if(a==='setconfig'){ var b=typeof p.json==='string'?JSON.parse(p.json):p.json; b.key=KULCS; var fake={postData:{contents:JSON.stringify(Object.assign({op:'setconfig'},b))},parameter:{}}; doPost(fake); return {ok:true}; }
  var all=rows_();
  if(a==='used'){ var code=String(p.code||''), hit=null; all.forEach(function(r){ if(r.test===true||String(r.code)!==code) return; if(r.ok===true||r.let===true){ if(!hit||r.ts>hit.ts) hit=r; } }); return {used:hit?{time:fmtHu_(hit.ts),device:hit.device||'',name:hit.name||''}:null}; }
  if(a==='scans'){ var arr=all; if(p.device) arr=arr.filter(function(r){return r.device===p.device;}); if(p.day) arr=arr.filter(function(r){return dayOf_(r.ts)===p.day;}); if(p.q){ var s=p.q.toLowerCase(); arr=arr.filter(function(r){ return String(r.code).toLowerCase().indexOf(s)>=0||String(r.name).toLowerCase().indexOf(s)>=0||String(r.type).toLowerCase().indexOf(s)>=0; }); } if(p.test!=='1') arr=arr.filter(function(r){return r.test!==true;}); arr.sort(function(x,y){ return String(y.ts).localeCompare(String(x.ts)); }); return arr.slice(0,+p.limit||500); }
  if(a==='stats'){ var today=dayOf_(new Date().toISOString()), per={}, t={day:today,in:0,out:0,fine:0,let:0}, byDev={}, devs={}, total=0;
    all.forEach(function(r){ if(r.test===true) return; total++; var d=dayOf_(r.ts), isIn=(r.ok===true||r.let===true); per[d]=per[d]||{day:d,in:0,out:0,fine:0,let:0}; if(isIn) per[d].in++; else per[d].out++; if(r.fine===true) per[d].fine++; if(r.let===true) per[d].let++;
      if(d===today){ if(isIn) t.in++; else t.out++; if(r.fine===true) t.fine++; if(r.let===true) t.let++; var k=r.device||'?'; byDev[k]=byDev[k]||{in:0,out:0}; if(isIn) byDev[k].in++; else byDev[k].out++; }
      var dv=devs[r.device]; if(r.device&&(!dv||dv.last<r.ts)) devs[r.device]={device:r.device,inspector:r.inspector||'',place:r.place||'',last:r.ts}; });
    var days=Object.keys(per).map(function(k){return per[k];}).sort(function(x,y){return y.day.localeCompare(x.day);}).slice(0,60);
    var devices=Object.keys(devs).map(function(k){ var d=devs[k]; d.in=(byDev[k]||{}).in||0; d.out=(byDev[k]||{}).out||0; d.ip=''; return d; });
    return {today:t,days:days,devices:devices,total:total}; }
  if(a==='clear'){ var sh=sheet_(); if(sh.getLastRow()>1) sh.deleteRows(2,sh.getLastRow()-1); return {ok:true}; }
  return {error:'nincs ilyen'};
}

